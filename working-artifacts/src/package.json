{
  "name": "whisker-boom",
  "version": "0.1.0",
  "private": true,
  "description": "Whisker Boom - a kid-friendly multi-device card game (working title)",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @wb/server start",
    "lint": "eslint apps packages && node apps/client/scripts/check-copy.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "check:copy": "node apps/client/scripts/check-copy.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8",
    "eslint-plugin-react-hooks": "^5.1.0"
  }
}
